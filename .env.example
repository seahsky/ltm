MATTERPORT_TOKEN_ID=
MATTERPORT_TOKEN_SECRET=

# Resend email notification for RACE runs (scripts/notify-run.sh).
# Copy to .env at the repo root and fill in; .env is gitignored.
RESEND_API_KEY=re_xxxxxxxx
NOTIFY_EMAIL_TO=you@example.com
# Free tier: onboarding@resend.dev can send to your own Resend account email, no domain needed
NOTIFY_EMAIL_FROM=onboarding@resend.dev
# NOTIFY_LOG_TAIL_LINES=400
